# SpendSense — Local API Keys
# ─────────────────────────────────────────────────────────────────────────────
# ⚠️  NEVER commit this file to git. It is listed in .gitignore.
# ⚠️  For CI/CD and release builds, pass keys via --dart-define instead.
#
# How to use:
#   1. Copy this file: cp .env.example .env
#   2. Fill in your real keys below
#   3. Run the app normally: flutter run
#
# 🔐 Recommended: Use the in-app AI Provider Settings screen (Settings → AI Provider Settings)
#    to securely store API keys in platform-encrypted storage instead of .env files.
# ─────────────────────────────────────────────────────────────────────────────

GROQ_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
