# Local machine and secret config
CLAUDE.md
AGENTS.md
# Firebase client config for the Android app. Tracked on purpose: it holds only
# public client identifiers (the same apiKey already lives in the committed
# lib/firebase_options.dart), it ships inside every APK regardless, and the
# release build fails without it. Real secrets stay in GitHub Secrets.
# android/app/google-services.json
android/build/
release/*.apk

# Local agent/IDE session state (never publish)
.omo/
.opencode/

# SECRETS
.env
*.jks
*.keystore
key.properties

# OTA hosting output: generated only from a verified, signed APK
/ota/public/manifest.json
/ota/public/releases/*
!/ota/public/releases/.gitkeep

# Local agent/tooling state, caches and pre-upgrade snapshots (never publish)
.perch/
.kiro/
.firebase/
*.before-upgrade
*.patch

# CI-only tooling installed with --no-save (tool/validate_yaml.js); never commit it.
node_modules/
