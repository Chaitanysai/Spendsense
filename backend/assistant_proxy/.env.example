# Server-side configuration for the SpendSense assistant proxy.
# NEVER commit real secrets. The app never receives GEMINI_API_KEY.
#
# GEMINI_API_KEY is NOT read from this file. Create it with:
#   firebase functions:secrets:set GEMINI_API_KEY --project spendsense-ota-2026
#
# Copy this file to .env.spendsense-ota-2026 (ignored by Git) for non-secret
# deployment configuration.

GEMINI_MODEL=gemini-2.5-flash

# Public Firebase Android app id that the App Check token must belong to.
# Defaulted in src/index.js to the SpendSense Android app id, which is public
# and already committed in firebase_options.dart. Set this only to override the
# default for another project/app. A mismatch fails closed.
SPENDSENSE_ANDROID_APP_ID=1:35486869641:android:62072850e90abafabc7e58

# App Check is always required by the deployed wrapper and cannot be disabled.
ALLOWED_ORIGIN=
UPSTREAM_TIMEOUT_MS=20000
# Per-IP flood limit, per-instance global cap, and the per-verified-UID quota.
RATE_LIMIT_PER_MINUTE=12
RATE_LIMIT_GLOBAL_PER_MINUTE=180
RATE_LIMIT_PER_USER_PER_MINUTE=12
# Per-instance daily cost circuit breakers. These are not a cross-instance
# quota; use a shared store for a hard global cap.
RATE_LIMIT_DAILY_PER_USER=100
RATE_LIMIT_DAILY_GLOBAL=2000
FUNCTION_REGION=asia-south1
